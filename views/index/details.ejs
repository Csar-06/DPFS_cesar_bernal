<!DOCTYPE html>
<html>

<%- include('../partials/header')%>

  <head>
    <link rel='stylesheet' href='/stylesheets/index/details-styles.css' />
    <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    <script src="../../javascripts/model-validation.js"></script>
    <script src="/javascripts/product-details.js"></script>
  </head>

  <body>

    <%- include('../partials/navbar') %>

      <div class="container">
        <main class="product-detail">
          <div class="product-container">
            <!-- Modelo 3D -->
            <div class="model-viewer">
              <model-viewer src="<%= item.render %>" alt="3D Model" auto-rotate camera-controls style="height: 400px;">
              </model-viewer>
              <img id="fallback-image" src="<%= item.image %>" alt="Product Image"
                style="height: 400px; display: none;">
            </div>


            <div class="product-info">
              <h3>
                <%= item.Brand.brand_name %>
              </h3>
              <h2>
                <%= item.Model.model %>
              </h2>
              <p>
                <%= item.description %>
              </p>

              <!-- Colores disponibles -->
              <div class="colors">
                <% 
                colors.forEach(color=> { %>
                  <div class="color-circle">
                    <div class="color-area" style="background: <%= color %>"></div>
                  </div>
                  <% }) %>
              </div>

              <!-- Control de cantidad -->
              <div class="quantity-price">
                <div class="quantity-selector">
                  <button id="decrease">-</button>
                  <span id="quantity">1</span>
                  <button id="increase">+</button>
                </div>
                <div class="price">$<%= item.unit_price %>
                </div>
              </div>


              <!-- Botones de acción -->
              <div class="actions">
                <button class="border-btn">Add to Cart</button>
                <button class="fill-btn">Buy</button>
              </div>
            </div>
          </div>
        </main>
      </div>


      <%- include('../partials/footer') %>


  </body>


</html>