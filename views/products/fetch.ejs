<!DOCTYPE html>
<html lang="en">

<%- include('../partials/header')%>

    <head>
        <link rel="stylesheet" href="../../stylesheets/products/crud-styles.css">
        <title>
            <%= title%>
        </title>
    </head>

    <body>

        <%- include('../partials/navbar')%>

            <h1>
                <%= title%>
            </h1>

            <a href="/logout">Cerrar sesión</a>

            <div class="form-container">
                <form action="/products/search" method="get" class="form">
                    <div class="search-bar">
                        <input type="text" name="fetch" id="fetch" placeholder="Search..." value="<%= query || '' %>">
                        <button type="submit" class="fetch-btn">
                            <ion-icon name="search"></ion-icon>
                        </button>
                    </div>
                </form>
            </div>

            <div class="container">

                <a href="/products/create">
                    <button class="create-btn">
                        &#10010; Create
                    </button>
                </a>


                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Brand</th>
                            <th>Model</th>
                            <th>Description</th>
                            <th>Image</th>
                            <th>Colors</th>
                            <th>Stock</th>
                            <th>Price</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(products.length > 0){

                            for(let item of products) { %>

                            <tr>
                                <td>
                                    <a href="/products/p/<%= item.id%>">
                                        <%= item.id %>
                                    </a>
                                </td>
                                <td>
                                    <%= item.brand %>
                                </td>
                                <td>
                                    <%= item.model %>
                                </td>
                                <td>
                                    <%= item.description %>
                                </td>
                                <td>
                                    <img src="<%= item.image %>" alt="<%= item.brand%> <%= item.model%>">
                                </td>
                                <td class="colors">
                                    <p style="background-color: <%=item.color%> "></p>
                                </td>
                                <td>
                                    <%= item.stock %>
                                </td>
                                <td>
                                    <%= item.price %>
                                </td>
                                <td class="actions">
                                    <a href="/products/<%= item.id%>/edit">
                                        <button class="btn-mod">
                                            Mod
                                        </button>
                                    </a>
                                    <form action="/products/p/<%= item.id %>?_method=DELETE" method="POST"
                                        style="display:inline;">
                                        <button type="submit" class="btn-del"
                                            onclick="return confirm(' ¿Estás seguro de eliminar este producto?')">
                                            Del
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            <% } } else { %>
                                <h2>No se encontraron productos.</h2>
                                <% } %>
                    </tbody>
                </table>
            </div>

    </body>

</html>