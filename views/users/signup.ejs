<!DOCTYPE html>
<html>

<%- include('../partials/header') %>

  <head>
    <link rel='stylesheet' href='/stylesheets/signup-styles.css' />
  </head>

  <body>
    <%- include('../partials/navbar') %>

      <div class="register-container">

        <h1 class="register-title">Create Your Nexxus Account</h1>

        <form class="register-form" action="/users/signup" method="POST" enctype="multipart/form-data">
          
          <% if (error) { %>
            <p class="error">
              <%= error %>
            </p>
            <% } %>

              <label for="firstName" class="register-label" id="nameLabel">First Name</label>
              <input type="text" id="firstName" name="firstName" class="register-input" required />

              <label for="lastName" class="register-label" id="lNameLabel">Last Name</label>
              <input type="text" id="lastName" name="lastName" class="register-input" required />

              <label for="email" class="register-label" id="emailLabel">Email</label>
              <input type="email" id="email" name="email" class="register-input" required />

              <label for="password" class="register-label" id="passwordLabel">Password</label>
              <input type="password" id="password" name="password" class="register-input" required />

              <label for="confirmPassword" class="register-label" id="passwordValidationLabel">Confirm Password</label>
              <input type="password" id="confirmPassword" name="confirmPassword" class="register-input" required />

              <label for="avatar" id="pictureLabel">Profile Picture</label>
              <input type="file" id="avatar" name="avatar" class="register-input" accept="image/*" />

              <button type="submit" class="register-button">SIGN UP</button>

              <p class="register-login">
                Already have an account?
                <a href="/users/login" class="login-link">Log in</a>
              </p>
        </form>
      </div>

      <script src="/javascripts/labelEvent.js"></script>
