<!DOCTYPE html>
<html lang="en">


<%- include('../partials/header')%>

    <head>
        <link rel="stylesheet" href="../../stylesheets/products/edit-styles.css">
        <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    </head>

    <body>
        <%- include('../partials/navbar')%>
        <div class="container">
            <h1 class="title">
                <%= title%>
            </h1>   

            <form action="/products/p/<%= product.id%>?_method=PUT" method="POST" class="form" id="form" enctype="multipart/form-data">
                <% if(error){ %>
                    <span>
                        <%= error%>
                    </span>
                <% }%>

                <div class="form-group">
                    <label for="brand">Brand</label>
                    <input type="text" id="brand" name="brand" value="<%= product ? product.brand : '' %>" >
                    <span class="err"></span>

                </div>

                <div class="form-group">
                    <label for="model">Model</label>
                    <input type="text" id="model" name="model" value="<%= product ? product.model : '' %>" >
                    <span class="err"></span>

                </div>

                <div class="form-group">
                    <label for="description">Descripción</label>
                    <textarea id="description" name="description" rows="4"
                        ><%= product ? product.description : '' %></textarea>
                </div>

                
                <div class="form-group">
                    <label for="image">Imagen del Producto</label>
                    
                    <% if (product && product.image) { %>
                        <div class="image-preview">
                            <img src="<%= product.image %>" alt="Imagen del producto" class="preview-img">
                        </div>
                        <p>Si deseas reemplazarla, sube una nueva imagen:</p>
                    <% } %>
        
                    <input type="file" id="image" name="image" accept="image/*">
                    <span class="err"></span>

                </div>

                <div class="form-group">
                    <label for="image">Render del Producto</label>
                    
                    <% if (product && product.render) { %>
                        <div class="image-preview">
                            <model-viewer src="<%= product.render %>" alt="3D Model" camera-controls
                                style="height: 125px; width: 100px;">
                            </model-viewer>
                        </div>
                        <p>Si deseas reemplazarla, sube un nuevo render:</p>
                    <% } %>
        
                    <input type="file" id="render" name="render" accept=".glb">
                </div>

                <div class="form-group">
                    <label for="quantity">Stock</label>
                    <input type="text" id="stock" name="stock" value="<%= product ? product.stock : '' %>">
                    <span class="err"></span>
                </div>

                <div class="form-group">
                    <label for="price">Price</label>
                    <input type="text" id="price" name="price" value="<%= product ? product.price : '' %>"> 
                    <span class="err"></span>

                </div>

                <div class="form-group">
                    <label for="colors">Color</label>
                        <input type="text" id="colors" name="colors" placeholder="Añadir color" value="<%= product.color%>">
                        <span class="err"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" onclick="return confirm('¿Desea guardar cambios?')"> 
                        <%= product ? 'Actualizar Producto' : 'Crear Producto' %>
                    </button>
                </div>
            </form>
        </div>

        <script src="../../javascripts/form-validations/validate-editProduct.js"></script>


    </body>

</html>