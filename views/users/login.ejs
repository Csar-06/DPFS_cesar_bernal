<!DOCTYPE html>
<html>

<head>
  <title>
    <%= title %>
  </title>
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link rel='stylesheet' href='/stylesheets/login-styles.css' />
</head>

<body>
  <%- include('partials/navbar')%>

  <div class="login-container">

    <h1 class="login-title">Sign In To Nexxus</h1>

    <form class="login-form" action="/login" method="POST">

      <label for="email" id="emailLabel" class="login-label">Email</label>
      <input type="email" id="email" name="email" class="login-input" required />

      <label for="password" id="passwordLabel" class="login-label">Password</label>
      <input type="password" id="password" name="password" class="login-input" required />

      <p class="login-forgot-password">
        <a href="/forgot-password">¿Forgot your password?</a>
      </p>

      <button type="submit" class="login-button">LOGIN</button>

      <p class="login-signup">
        ¿Don't have an account?
        <a href="/signup" class="signup-link">Sign up</a>
      </p>

    </form>

  </div>
<script src="javascripts/labelEvent.js"></script>
</body>

</html>