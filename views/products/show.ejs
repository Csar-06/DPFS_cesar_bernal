<!DOCTYPE html>
<html lang="es">

<%- include('../partials/header')%>

    <head>
        <link rel='stylesheet' href='/stylesheets/index/details-styles.css' />
        <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
        <script src="../../javascripts/model-validation.js"></script>
        <script src="/javascripts/product-details.js"></script>
    </head>

    <body>

        <%- include('../partials/navbar') %>

            <div class="container">
                <main class="product-detail">
                    <div class="product-container">
                        <!-- Modelo 3D -->
                        <div class="model-viewer">
                            <% if (product.render) { %>
                                <model-viewer src="<%= product.render %>" alt="3D Model" auto-rotate camera-controls
                                    style="height: 400px;">
                                </model-viewer>
                            <% } else { %>
                                    <img id="fallback-image" src="<%= product.image %>" alt="Product Image"
                                        style="height: 400px;">
                            <% } %>
                        </div>


                        <div class="product-info">
                            <h3>
                                <%= product.brand %>
                            </h3>
                            <h2>
                                <%= product.model %>
                            </h2>
                            <p>
                                <%= product.description %>
                            </p>

                            <!-- Colores disponibles -->
                            <div class="colors">
                                <div class="color-circle">
                                    <div class="color-area" style="background: <%= product.color %>"></div>
                                </div>
                            </div>

                            <!-- Control de cantidad -->
                            <div class="quantity-price">
                                <div class="quantity-selector">
                                    <button id="decrease">-</button>
                                    <span id="quantity">1</span>
                                    <button id="increase">+</button>
                                </div>
                                <div class="price">$<%= product.price %>
                                </div>
                            </div>


                        </div>
                    </div>
                    <div class="controls">
                        <a href="/products" class="border-btn">Volver al listado</a>
                        <a href="/products/<%= product.id %>/edit" class="btn-mod">Editar</a>

                        <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="display:inline;">
                            <button type="submit" onclick="return confirm('¿Estás seguro de eliminar este producto?')"
                                class="btn-del">Eliminar</button>
                        </form>

                    </div>
                </main>
            </div>



            <%- include('../partials/footer') %>

    </body>

</html>