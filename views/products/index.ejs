<!DOCTYPE html>
<html lang="en">

<%- include('../partials/header')%>

    <head>
        <link rel="stylesheet" href="../../stylesheets/products/crud-styles.css">
        <title>
            <%= title%>
        </title>
    </head>

    <body>

        <h1>
            <%= title%>
        </h1>

        
        
        <a href="/logout">Cerrar sesión</a>

        <div class="container">

            <a href="/products/create">
                <button class="create-btn">
                    &#10010; Create
                </button>
            </a>


            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Brand</th>
                        <th>Model</th>
                        <th>Description</th>
                        <th>Image</th>
                        <th>Colors</th>
                        <th>Stock</th>
                        <th>Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(item=> { %>

                        <tr>
                            <td>
                                <a href="/products/<%= item.id%>">
                                    <%= item.id %>
                                </a>
                            </td>
                            <td>
                                <%= item.brand %>
                            </td>
                            <td>
                                <%= item.model %>
                            </td>
                            <td>
                                <%= item.description.substring(0, 50) + '...' %>
                            </td>
                            <td>
                                <img src="<%= item.image %>" alt="<%= item.brand%> <%= item.model%>">
                            </td>
                            <td>
                                <%= item.colors %>
                            </td>
                            <td>
                                <%= item.stock %>
                            </td>
                            <td>
                                <%= item.price %>
                            </td>
                            <td class="actions">
                                <a href="./products/<%= item.id%>/edit">
                                    <button class="btn-mod">
                                        Mod
                                    </button>
                                </a>
                                <form action="/products/<%= item.id %>?_method=DELETE" method="POST"
                                    style="display:inline;">
                                    <button type="submit" class="btn-del"
                                        onclick="return confirm(' ¿Estás seguro de eliminar este producto?')">
                                        Del
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>

    </body>

</html>