<!DOCTYPE html>
<html>

<%- include('../partials/header')%>

  <head>
    <link rel='stylesheet' href='/stylesheets/users/login-styles.css' />
  </head>

  <body>
    <%- include('../partials/navbar')%>

      <div class="login-container">

        <h1 class="login-title">Sign In To Nexxus</h1>

        <form class="login-form" id="login-form" action="/users/login" method="POST">

          <label for="email" id="emailLabel" class="login-label">Email</label>
          <input type="email" id="email" name="email" class="login-input"  />
          <span class="err"></span>

          <label for="password" id="passwordLabel" class="login-label">Password</label>
          <input type="password" id="password" name="password" class="login-input"  />
          <span class="err"></span>

          <p class="login-forgot-password">
            <a href="/forgot-password">¿Forgot your password?</a>
          </p>

          <!-- Mostrar mensaje de error si existe -->
          <% if (error) { %>
            <p class="error">
              <%= error %>
            </p>
            <% } %>
            
              <button type="submit" class="login-button">LOGIN</button>

              <p class="login-signup">
                ¿Don't have an account?
                <a href="/users/signup" class="signup-link">Sign up</a>
              </p>

        </form>

      </div>
      <script src="/javascripts/labelEvent.js"></script>
      <!-- <script src="/javascripts/form-validations/validate-loginForm.js"></script> -->
  </body>

</html>