<!DOCTYPE html>
<html lang="es">

<%- include('../partials/header') %>

<head>
    <link rel="stylesheet" href="stylesheets/index/index-styles.css"> <!-- Archivo de estilos CSS -->
</head>

<body>

    <%- include('../partials/navbar') %>

    <!-- Sección de slider al iniciar la web -->
    <div class="slider-container">
        <div class="carousel">
            <% slides.forEach((slide, index) => { %>
                <video class="carousel-slide" src="<%= slide %>" autoplay muted loop poster="path/to/your/poster.jpg"></video>
            <% }) %>
        </div>
        <button class="carousel-prev" aria-label="Previous Slide">&#10094;</button>
        <button class="carousel-next" aria-label="Next Slide">&#10095;</button>
    </div>

    <!-- Sección de Ofertas -->
    <section id="ofertas" class="ofertas-section">
        <h2 class="ofertas-title">Últimas Ofertas</h2>
        <div class="ofertas-container">
            <div class="ofertas-content">

                <!-- Producto en grande -->
                <a href="/phones/id/2" id="item" class="producto-grande">
                    <img src="../../uploads/product_image/iphone-15-pro.png" id="img" alt="iPhone 15 pro" class="producto-img" />
                    <label class="producto-label">iPhone 15 pro</label>
                </a>

                <!-- Productos en mosaico -->
                <div class="productos-mosaico">
                    <% for (let i = 2; i <= 5; i++) { %>
                        <a href="#ofertas" class="producto-mosaico">
                            <img src="images/vite.svg" alt="Product image" class="producto-img" loading="lazy" />
                            <label class="producto-label">Producto <%= i %></label>
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>

    <script src="javascripts/carousel.js"></script>
</body>

</html>
