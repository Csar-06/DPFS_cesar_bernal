<!DOCTYPE html>
<html lang="en">


<%- include('../partials/header')%>

    <head>
        <link rel="stylesheet" href="../../stylesheets/products/modItem-form-styles.css">
    </head>

    <body>

        <div class="container">
            <h1 class="title">
                <%= title%>
            </h1>

            <form action="#" method="POST" class="form">
                <div class="form-group">
                    <label for="brand">Brand</label>
                    <input type="text" id="brand" name="brand" value="<%= item ? item.brand : '' %>" required>
                </div>

                <div class="form-group">
                    <label for="model">Model</label>
                    <input type="text" id="model" name="model" value="<%= item ? item.model : '' %>" required>
                </div>

                <div class="form-group">
                    <label for="description">Descripción</label>
                    <textarea id="description" name="description" rows="4"
                        required><%= item ? item.description : '' %></textarea>
                </div>

                <!-- <div class="form-group">
                    <label for="image">Imagen URL</label>
                    <input type="text" id="image" name="image" value="<%= item ? item.image : '' %>">
                </div> -->
                
                <div class="form-group">
                    <label for="image">Imagen del Producto</label>
                    
                    <% if (item && item.image) { %>
                        <div class="image-preview">
                            <img src="../../<%= item.image %>" alt="Imagen del producto" class="preview-img">
                        </div>
                        <p>Si deseas reemplazarla, sube una nueva imagen:</p>
                    <% } %>
        
                    <input type="file" id="image" name="image" accept="image/*">
                </div>

                <div class="form-group">
                    <label for="quantity">Stock</label>
                    <input type="text" id="quantity" name="quantity" value="<%= item ? item.stock : '' %>">
                </div>

                <div class="form-group">
                    <label for="price">Price</label>
                    <input type="text" id="price" name="price" value="<%= item ? item.price : '' %>">
                </div>

                <div class="form-group">
                    <label for="colors">Colors</label>
                    <div class="color-input">
                        <input type="text" id="newColor" name="newColor" placeholder="Añadir color">
                        <button type="button" id="addColor">Añadir</button>
                    </div>
                    <ul id="colorList">
                        <% if (item && item.colors) { %>
                            <% item.colors.forEach(color=> { %>
                                <li>
                                    <%= color %>
                                </li>
                                <% }) %>
                                    <% } %>
                    </ul>
                </div>

                <div class="form-actions">
                    <button type="submit">
                        <%= item ? 'Actualizar Producto' : 'Crear Producto' %>
                    </button>
                </div>
            </form>
        </div>

        <script>
            document.getElementById('addColor').addEventListener('click', function () {
                const newColorInput = document.getElementById('newColor');
                const colorList = document.getElementById('colorList');

                if (newColorInput.value.trim() !== '') {
                    const li = document.createElement('li');
                    li.textContent = newColorInput.value;
                    colorList.appendChild(li);
                    newColorInput.value = '';
                }
            });
        </script>


    </body>

</html>